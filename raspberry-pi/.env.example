# ─────────────────────────────────────────────────────────────────────────────
# Raspberry Pi shop-floor listener
#
# Copy to `.env` in this directory:   cp .env.example .env
# Every value has a default; you normally only need BACKEND_URL and AUDIO_DEVICE.
# ─────────────────────────────────────────────────────────────────────────────

# --- REQUIRED ON A REAL PI ---------------------------------------------------
# The LAN address of the machine running the backend. NOT localhost: on the Pi,
# localhost is the Pi itself.
#
# Find it on the backend machine:
#   Windows        ipconfig            (look for IPv4 Address)
#   macOS / Linux  ip addr | grep inet
#
# Then check from the Pi:  curl http://192.168.1.10:8000/health
BACKEND_URL=http://192.168.1.10:8000

# For running the client on the same machine as the backend:
# BACKEND_URL=http://localhost:8000

MERCHANT_ID=PAYTM_M_001
DEVICE_ID=pi-shopfloor-01
VOICE_OUTPUT_MODE=raspberry_pi

# NOTE: no API keys belong on the Pi. It posts raw audio to the backend and
# the backend alone talks to Sarvam. If you find yourself adding SARVAM_API_KEY
# here, the architecture has gone wrong.

# --- Microphone --------------------------------------------------------------
# Index or part of the device name. Leave empty for the system default.
# List them:  python pi_client.py --list-devices    (or: arecord -l)
#
# Prefer a NAME over an index: USB device numbers move between reboots.
#   AUDIO_DEVICE=USB
#   AUDIO_DEVICE=1
AUDIO_DEVICE=

SAMPLE_RATE=16000
CHANNELS=1
RECORDING_DURATION=8

# --- Voice activity gate -----------------------------------------------------
# Stops the Pi uploading hours of silence. Raise the threshold in a noisy shop,
# lower it if quiet speech is being missed.
# Check your levels with:  python audio_capture.py
VAD_ENABLED=true
VAD_RMS_THRESHOLD=0.015
VAD_MIN_VOICED_RATIO=0.06

# --- Modes -------------------------------------------------------------------
# DEMO_MODE: never touch the microphone; post scripted transcripts instead.
# Useful for testing the link before the mic arrives.
DEMO_MODE=false

# LOCAL_TRANSCRIPTION (Mode A): transcribe on the Pi and send text.
# Leave false. A Pi 4B running `small` is ~6-8x slower than real time and
# falls permanently behind a live shop. If you must, use `tiny`.
LOCAL_TRANSCRIPTION=false
WHISPER_MODEL_SIZE=tiny

# --- Networking --------------------------------------------------------------
REQUEST_TIMEOUT=45
MAX_RETRIES=3
RETRY_BACKOFF=2
LOOP_PAUSE=0.5

# --- Storage -----------------------------------------------------------------
# KEEP_AUDIO=true keeps every WAV. Useful when tuning the mic, and a good way
# to fill a 16 GB card overnight, so leave it off in normal use.
KEEP_AUDIO=false
# LOG_FILE=/home/pi/vyapaar.log
