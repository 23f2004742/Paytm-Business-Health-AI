# ─────────────────────────────────────────────────────────────────────────────
# Paytm Vyapaar AI: environment
#
# EVERYTHING HERE IS OPTIONAL. With no variables set at all, the whole product
# runs end to end: health score, anomaly detection, buyer/seller conversation
# intelligence, demand fulfilment scoring, root cause analysis, unified
# insights, recommendations and both merchant actions.
#
# Copy to `.env` in this directory to change anything.
#
#   cp .env.example .env
#
# NEVER commit a real key. `.env` is gitignored; this file holds placeholders.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
#  SARVAM AI
#
#  Built for Indian languages, which is exactly what shop-floor Hinglish is.
#  Used for speech-to-text and for phrasing explanations.
#
#  The key lives HERE ONLY, on the backend. It is never sent to the frontend,
#  never sent to the Raspberry Pi, and never written to a log. The Pi posts raw
#  audio to this backend and the backend alone talks to Sarvam.
#
#  Leave the placeholder in place and the product runs deterministically.
# ═════════════════════════════════════════════════════════════════════════════

# SARVAM_API_KEY=YOUR_SARVAM_API_KEY
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_LANGUAGE_CODE=unknown        # `unknown` auto-detects; best for Hinglish
#
# CHAT MODEL: the old `sarvam-m` default is DEPRECATED and returns HTTP 400.
# Current models are `sarvam-105b` and `sarvam-105b-conversations`.
#
#   sarvam-105b               reasoning model. Emits `reasoning_content` and
#                             spends ~100 completion tokens thinking before it
#                             answers; at low max_tokens `content` is null.
#   sarvam-105b-conversations plain chat, clean `content`. PREFERRED here,
#                             because this product only asks a model to phrase
#                             numbers that were computed deterministically.
# SARVAM_CHAT_MODEL=sarvam-105b-conversations


# ═════════════════════════════════════════════════════════════════════════════
#  PROVIDERS
# ═════════════════════════════════════════════════════════════════════════════

# --- Language / explanation ---------------------------------------------------
# template   deterministic, no network, no keys                     (DEFAULT)
# mock       forces deterministic output regardless of keys present
# sarvam     Sarvam AI chat
# ollama     a local model over Ollama's HTTP API
# openai     OpenAI chat completions
# anthropic  the Anthropic Messages API
#
# Selection is explicit: setting a key alone does NOT switch providers. That
# keeps the demo reproducible on any machine.
#
# A model only ever changes PHRASING. It never computes the score, an anomaly,
# a speaker role, an outcome, or any number in this product.

# AI_PROVIDER=template

# --- Speech to text -----------------------------------------------------------
# auto       Sarvam if a key is set, else local Whisper if installed,
#            else mock when DEMO_MODE is on                         (DEFAULT)
# sarvam     Sarvam AI speech-to-text
# whisper    local faster-whisper (alias: `existing`)
# mock       canned transcripts; the audio is NOT decoded
#
# Falls back rather than failing: a missing key or an outage degrades to the
# next option and the response says which engine actually ran.

# TRANSCRIPTION_PROVIDER=auto

# Local Whisper settings, used only when that provider is active.
# Install with: pip install -r backend/requirements-optional.txt
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# Ollama, used only when AI_PROVIDER=ollama.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5

# Other model providers, used only when the matching AI_PROVIDER is selected.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...


# ═════════════════════════════════════════════════════════════════════════════
#  PAYTM MERCHANT DATA
#
#  THIS PROJECT HAS NO PAYTM API ACCESS. Transaction intelligence runs on a
#  synthetic dataset generated by backend/data/generate_data.py. The provider
#  abstraction exists so a real integration can be dropped in later; selecting
#  `api` raises a clear error rather than pretending to be live.
# ═════════════════════════════════════════════════════════════════════════════

# PAYTM_PROVIDER=mock        # mock | api (api is not implemented)


# ═════════════════════════════════════════════════════════════════════════════
#  TWILIO - merchant SMS / WhatsApp alerts
#
#  Optional, like everything else here. With nothing set, raising a restock
#  alert and launching a campaign both still succeed; the response simply
#  reports that no message went out.
#
#  Authentication is an API Key, NOT the account auth token. That means
#  THREE values: the key SID (SK...) and its secret are the HTTP basic auth
#  pair, and the Account SID (AC...) is still needed for the REST path. A
#  missing Account SID is the usual reason a valid API Key 404s.
#
#  Do not know your Account SID? The key itself can find it:
#    curl -u "SK...:secret" https://api.twilio.com/2010-04-01/Accounts.json
# ═════════════════════════════════════════════════════════════════════════════

# TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
# TWILIO_API_KEY_SID=YOUR_TWILIO_API_KEY_SID
# TWILIO_API_KEY_SECRET=YOUR_TWILIO_API_KEY_SECRET

# The sender: a purchased number, or the WhatsApp sandbox sender. A trial
# account owns no numbers until you buy one.
#   TWILIO_FROM_NUMBER=+1XXXXXXXXXX
#   TWILIO_FROM_NUMBER=whatsapp:+14155238886
# TWILIO_FROM_NUMBER=

# Where merchant alerts go. On a trial account this MUST be a Twilio-verified
# number, or Twilio rejects the send with error 21608.
# MERCHANT_ALERT_NUMBER=

# Off by default so a demo never spends credit or texts a real phone.
# TWILIO_NOTIFICATIONS_ENABLED=false

# Check configuration:  GET  /api/notifications/status
# Prove the channel:    POST /api/notifications/test

# =============================================================================
#  TELEGRAM - merchant alerts
#
#  1. Create a bot with @BotFather and copy its token.
#  2. Send /start to your bot (or add it to the target group).
#  3. Obtain the numeric chat ID, then set the values below.
# =============================================================================
# MESSAGING_PROVIDER=telegram
# TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# TELEGRAM_NOTIFICATIONS_ENABLED=true

# Telegram AI assistant. `polling` works while the local FastAPI backend is
# running; use `webhook` only for a deployed public HTTPS URL.
# TELEGRAM_BOT_MODE=polling             # off | polling | webhook
# TELEGRAM_BOT_VOICE_REPLIES=true       # sends an MP3 reply via Sarvam Bulbul
# TELEGRAM_BOT_ALLOWED_CHAT_IDS=YOUR_TELEGRAM_CHAT_ID
# TELEGRAM_WEBHOOK_SECRET=YOUR_LONG_RANDOM_SECRET
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_PACE=1.0
#
# Local alternative: python scripts/run_telegram_bot.py
# Webhook endpoint: POST /api/telegram/webhook (requires the secret header)

# Optional lending-message preview. The default link is a safe example.com
# URL and does not collect money. Replace it only with a verified payment link.
# LENDING_BRAND_NAME=Sujit Shopwala Lending
# LENDING_DEMO_PAYMENT_LINK=https://example.com/?payment=DEMO-LOAN-001
# Send the preview: POST /api/notifications/lending-demo


# ═════════════════════════════════════════════════════════════════════════════
#  APPLICATION
# ═════════════════════════════════════════════════════════════════════════════

# DEMO_MODE=true

# --- AI Box / Smart Khata ---------------------------------------------------
# Financial speech updates require this confidence; lower-confidence events
# are recorded for confirmation and never change a balance automatically.
# KHATA_AUTO_UPDATE_THRESHOLD=0.85
# How the spoken reply is produced.
#   auto      Sarvam Bulbul when SARVAM_API_KEY is set, else browser  (default)
#   sarvam    Bulbul audio, returned inline as a base64 data URI. Sounds like a
#             person and reads Hinglish correctly. Fractions of a paisa a line.
#   browser   the client's own Web Speech voice. Free and offline, but tuned
#             for English, so it reads Hinglish like a satnav.
#   mock      no audio at all
# TTS_PROVIDER=auto                # auto | sarvam | browser | mock
# SARVAM_TTS_MODEL=YOUR_CONFIGURED_TTS_MODEL
# VOICE_OUTPUT_MODE=browser        # browser | raspberry_pi
# AI_BOX_DEMO_MODE=false           # only enable canned AI Box input for tests
#   true  : if the shop store is empty, seed a scripted two-week shop history
#           anchored to the dataset's own "today". The dashboard is populated
#           without any microphone, Pi, or network.
#   false : the shop floor starts empty and fills only from real events.
#
# Real Pi events are always accepted and always stored, in either mode.

# DEMO_MODE=true

# --- Business Health Score ----------------------------------------------------
# Weight given to the Demand Fulfilment component (the sixth component, added
# by the conversation intelligence layer). Range 0 to 0.4.
#
# Set to 0 to restore the original five-component transaction-only score.
#
# When a week has no conversation data, this weight is redistributed across
# the other five components, so weeks stay comparable either way.

# DEMAND_FULFILLMENT_WEIGHT=0.15
# DEMAND_FULFILLMENT_ENABLED=true

# --- Transaction correlation --------------------------------------------------
# How long after a conversation a payment still counts as possibly related.
# TRANSACTION_MATCH_WINDOW_SECONDS=180

# --- Backend ------------------------------------------------------------------
# BACKEND_HOST=0.0.0.0        # 0.0.0.0 so the Raspberry Pi can reach it
# BACKEND_PORT=8000

# Browser origins allowed to call the API. The Pi does NOT need an entry: it is
# an HTTP client, not a browser, so CORS never applies to it.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend -----------------------------------------------------------------
# Where the browser reaches the API. This one goes in frontend/.env.local
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000


# ═════════════════════════════════════════════════════════════════════════════
#  RASPBERRY PI
#
#  These belong in raspberry-pi/.env on the Pi itself, NOT here.
#  See raspberry-pi/.env.example and raspberry-pi/README_PI.md.
#
#    BACKEND_URL=http://YOUR_BACKEND_LAN_IP:8000
#    MERCHANT_ID=PAYTM_M_001
#    AUDIO_DEVICE=            # empty = system default; or an index/name
#    RECORDING_DURATION=8
#    DEMO_MODE=false
#
#  The Pi never receives SARVAM_API_KEY or any other credential.
# ═════════════════════════════════════════════════════════════════════════════

# --- Payment links on reminders ---------------------------------------------
# A collections reminder can carry a "Pay Now" link. Real Paytm payment links
# need Paytm's payment-links API, which this project does NOT have.
#
# Leave this unset and the reminder simply asks for payment with no link,
# which is deliberate: a dead link inside a payment request reads as a scam
# and costs the merchant the customer.
#
# Set it to a base URL you actually control and each reminder gets
# <base>/<reminder_id>.
# PAYMENT_LINK_BASE=https://paytm.me

# Simplest credential style for a NEW account: both values sit on the Twilio
# Console home page. Use these OR the API key pair above, not both.
# TWILIO_AUTH_TOKEN=your_auth_token_here


# =============================================================================
#  META WHATSAPP CLOUD API  (the active channel)
#
#  Chosen over Twilio because Twilio's trial refuses free text on every
#  channel: WhatsApp wants a ContentSid, SMS wants a predefined template name,
#  and creating a template needs a paid plan. A payment reminder has to say a
#  real name and a real amount, so none of that works.
#
#  Meta's free tier gives a test sender instantly, allows custom templates,
#  and lets free text through inside the 24-hour window.
#
#  WHERE THESE COME FROM
#    developers.facebook.com -> your app -> WhatsApp -> API Setup
#      Phone number ID   a long number under "From"
#      Access token      the temporary token on that page (24h), or a
#                        permanent System User token for something lasting
#
#  The recipient must also be added on that page under "To" and confirmed by
#  the OTP WhatsApp sends. A test sender can hold up to five numbers.
# =============================================================================
# MESSAGING_PROVIDER=whatsapp_cloud
# WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
# WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_NOTIFICATIONS_ENABLED=true
